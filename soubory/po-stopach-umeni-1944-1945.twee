<p class="map-note">Hover over any marker for details · Map is schematic, not to precise scale</p>

<script>
const tt = document.getElementById('tt');
const wrap = document.getElementById('mapWrap');

document.querySelectorAll('.repo').forEach(el => {
  el.addEventListener('mouseenter', function(e) {
    tt.innerHTML =
      '<span class="tt-name">' + this.dataset.name + '</span>' +
      '<span class="tt-ctry">' + this.dataset.country + '</span>' +
      '<span class="tt-info">'  + this.dataset.info  + '</span>';
    tt.classList.add('show');
    positionTip(e);
  });
  el.addEventListener('mousemove', positionTip);
  el.addEventListener('mouseleave', () => tt.classList.remove('show'));
});

function positionTip(e) {
  const rect = wrap.getBoundingClientRect();
  let x = e.clientX - rect.left + 14;
  let y = e.clientY - rect.top  + 14;
  // keep inside wrapper
  const tw = tt.offsetWidth  || 220;
  const th = tt.offsetHeight || 80;
  if (x + tw > rect.width  - 8) x = e.clientX - rect.left - tw - 10;
  if (y + th > rect.height - 8) y = e.clientY - rect.top  - th - 10;
  tt.style.left = x + 'px';
  tt.style.top  = y + 'px';
}
</script>
</body>
</html>


