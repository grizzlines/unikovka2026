@import url('https://fonts.googleapis.com/css2?family=Special+Elite&family=Courier+Prime:wght@400;700&display=swap');

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  background: #0f0e0c;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 2rem 1rem 3rem;
  font-family: 'Courier Prime', monospace;
  min-height: 100vh;
}

h1 {
  font-family: 'Special Elite', serif;
  color: #9a7c2a;
  font-size: clamp(1rem, 3vw, 1.35rem);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  text-align: center;
  margin-bottom: 0.3rem;
}
.subtitle {
  color: #5a4a2a;
  font-size: 0.7rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  margin-bottom: 1.5rem;
  text-align: center;
}

.map-wrap {
  position: relative;
  width: 100%;
  max-width: 900px;
  border: 1px solid rgba(154,124,42,0.3);
  border-top: 5px solid #8c1a00;
  box-shadow: 0 0 0 4px #0f0e0c, 0 8px 50px rgba(0,0,0,0.8);
}

svg#map { display: block; width: 100%; height: auto; }

/* repo dots interactivity */
.repo { cursor: pointer; }
.repo circle.outer { transition: r 0.15s; }
.repo:hover circle.outer { r: 8; }

/* in-game star glow */
@keyframes starPulse {
  0%,100% { opacity: 0.25; r: 9; }
  50%      { opacity: 0.5;  r: 13; }
}
.pulse { animation: starPulse 2.2s ease-in-out infinite; }

/* Tooltip */
.tooltip {
  position: absolute;
  background: #140f08;
  border: 1px solid #6a5218;
  border-left: 3px solid #8c1a00;
  color: #e8dfc8;
  font-family: 'Courier Prime', monospace;
  font-size: 0.78rem;
  padding: 0.55rem 0.9rem;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.15s;
  max-width: 240px;
  line-height: 1.55;
  z-index: 20;
  border-radius: 1px;
}
.tooltip.show { opacity: 1; }
.tooltip .tt-name  { color: #e8c860; font-weight: 700; display: block; margin-bottom: 0.15rem; font-size: 0.82rem; }
.tooltip .tt-ctry  { color: #9a7c2a; font-size: 0.7rem; display: block; margin-bottom: 0.3rem; letter-spacing: 0.06em; text-transform: uppercase; }
.tooltip .tt-info  { color: #c8b890; font-size: 0.75rem; }

/* Legend */
.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 0.7rem 2.5rem;
  margin-top: 1.2rem;
  padding: 0.75rem 1.2rem;
  border: 1px solid rgba(154,124,42,0.18);
  max-width: 900px;
  width: 100%;
}
.li { display: flex; align-items: center; gap: 0.55rem; font-size: 0.71rem; color: #8a7040; letter-spacing: 0.04em; }
.li svg { flex-shrink: 0; }

.map-note {
  margin-top: 0.9rem;
  font-size: 0.65rem;
  color: #3a2e18;
  letter-spacing: 0.08em;
  text-align: center;
  max-width: 900px;
}
</style>
